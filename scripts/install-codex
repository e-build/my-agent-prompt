#!/usr/bin/env bash
set -euo pipefail

# Install Codex resources from this repo.
#
# Resources:
#   resources/commands/          → ~/.agents/commands/      (shared command bodies)
#   resources/templates/         → ~/.agents/templates/     (templates used by bodies)
#   adapters/codex/skills/<name> → ~/.agents/skills/<name>  (command wrappers)
#
# Codex reads ~/.agents/skills/ natively and has deprecated custom prompts, so
# shared commands ship as explicit-only skills: invoke them with $<name>.
# agents/openai.yaml turns off implicit invocation for Codex, and
# disable-model-invocation does the same for other tools that read the folder.
#
# Locally maintained skills are installed by scripts/install-skills.
# External skills: python3 scripts/sync-external-skills.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/link.sh
source "$ROOT/scripts/lib/link.sh"
AGENTS_HOME="${AGENTS_HOME:-$HOME/.agents}"

usage() {
  cat <<'EOF'
Usage:
  bash scripts/install-codex    # install Codex command skills + shared bodies
  bash scripts/install-codex -h # show this help

Skills (separate):
  bash scripts/install-skills         # locally maintained skills
  python3 scripts/sync-external-skills # registered external skills
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

echo "Installing Codex resources → $AGENTS_HOME"
mkdir -p "$AGENTS_HOME/skills"

# 1. Shared command bodies and templates (read by the command skills)
link_shared "$AGENTS_HOME" "$ROOT"

# 2. Command skills
installed=0
skipped=0
for d in "$ROOT/adapters/codex/skills/"*/; do
  [[ -f "$d/SKILL.md" ]] || continue
  name="$(basename "$d")"
  dst="$AGENTS_HOME/skills/$name"

  # Guard: never touch a real (non-symlink) directory the user manages.
  if [[ -e "$dst" && ! -L "$dst" ]]; then
    echo "  ⚠ skipped $name: real directory exists at $dst (user-managed)"
    skipped=$((skipped + 1))
    continue
  fi

  link_dir "${d%/}" "$dst"
  installed=$((installed + 1))
done
echo "  ✓ $installed command skill(s) installed, $skipped skipped"

echo ""
echo "✅ Codex install complete. Restart Codex, then run /skills or type \$<command>."
